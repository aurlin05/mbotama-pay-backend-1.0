# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/mbotamapay_db
DATABASE_USERNAME=mbotamapay_admin
DATABASE_PASSWORD=Aurlin10

# JWT Configuration
JWT_SECRET=mbotamapay-super-secret-key-change-in-production-min-256-bits-required

# Email Configuration (SMTP)
# Pour Gmail, vous devez activer l'authentification à deux facteurs
# et générer un "App Password" : https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# SMS Configuration (si vous utilisez un service SMS)
SMS_API_KEY=
SMS_API_URL=

# Application URLs
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# Payment Gateways
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=

# CinetPay : identifiants par pays, ISO:api_key:api_password séparés par des virgules
CINETPAY_API_URL=https://api.cinetpay.net
CINETPAY_CREDENTIALS=
CINETPAY_DEFAULT_CLIENT_EMAIL=

PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# pawaPay (sandbox par défaut ; production : https://api.pawapay.io)
PAWAPAY_ENABLED=false
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
